# AI 一人学校 · 环境变量示例（BYO：所有模型 API 密钥请填自己的）
# 复制为 .env 后填写；.env 已被 git 忽略，本文件不包含任何真实密钥。

VITE_APP_NAME=AI一人学校
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 账号入库：在 Supabase SQL Editor 执行 supabase/school_accounts.sql

# ===== 老师 / 监督 Agent（必需：DeepSeek 或兼容 OpenAI 接口的服务） =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY_BACKUP=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 教案生成 / 监督 Agent 单独使用的 key（不填则回退到 DEEPSEEK_API_KEY；再没有就使用规则模式）
PLAN_API_KEY=
PLAN_API_BASE=https://api.deepseek.com
PLAN_MODEL=deepseek-chat

# ===== 语音 =====
# 默认使用免费 Edge TTS（不需要 key）；MiniMax 默认停用
TTS_PROVIDER=edge
MINIMAX_DISABLED=1
EDGE_VOICE_EN=en-US-AriaNeural
EDGE_VOICE_ZH=zh-CN-XiaoxiaoNeural
PYTHON_BIN=

# 本地离线语音识别（Vosk）
LOCAL_ASR_URL=http://127.0.0.1:8201
VOSK_MODEL_DIR=

# ===== 可选 =====
# MiniMax 超真人语音 / 图片生成（需要自己的 key，且把 MINIMAX_DISABLED 改为 0）
INTEGRATIONS_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_IMAGE_MODEL=image-01
# 口语发音评测（Azure Pronunciation Assessment）；不配则 /api/pronunciation 返回 501
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_PA_LOCALE=en-US
